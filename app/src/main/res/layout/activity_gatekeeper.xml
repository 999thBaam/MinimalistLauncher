<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".GatekeeperActivity">

    <!-- Main Content Container -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="24dp">

        <!-- ==================== ZONE 1: THE NORTH STAR (Top) ==================== -->
        <LinearLayout
            android:id="@+id/northStarZone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="32dp"
            android:paddingBottom="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Main Goal Text -->
            <TextView
                android:id="@+id/goalText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:letterSpacing="0.05"
                android:textAllCaps="true"
                android:textColor="@color/primaryText"
                android:textSize="32sp"
                android:textStyle="bold"
                tools:text="IIT BOMBAY CSE" />

            <!-- Countdown Timer -->
            <TextView
                android:id="@+id/countdownText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"
                android:textAllCaps="true"
                android:textColor="@color/secondaryText"
                android:textSize="16sp"
                tools:text="124 Days Left" />

            <!-- Edit Goal Button (subtle) -->
            <ImageView
                android:id="@+id/editGoalButton"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="8dp"
                android:alpha="0.5"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Edit Goal"
                android:focusable="true"
                android:src="@drawable/ic_settings"
                app:tint="@color/secondaryText" />
        </LinearLayout>

        <!-- ==================== ZONE 2: THE BATTLEGROUND (Center) ==================== -->
        <FrameLayout
            android:id="@+id/battlegroundZone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintBottom_toTopOf="@id/trophyRoomButton"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/northStarZone">

            <!-- Task List RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/taskRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:scrollbars="none" />

            <!-- Victory State (when all tasks completed) -->
            <LinearLayout
                android:id="@+id/victoryState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Day Won."
                    android:textColor="@color/primaryText"
                    android:textSize="28sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif"
                    android:text="Rest Now."
                    android:textColor="@color/secondaryText"
                    android:textSize="18sp" />
            </LinearLayout>

            <!-- Empty State (no tasks yet) -->
            <LinearLayout
                android:id="@+id/emptyState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:text="No tasks for today"
                    android:textColor="@color/secondaryText"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/addTaskHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:padding="8dp"
                    android:text="+ Add your first task"
                    android:textColor="@color/minimalist_accent"
                    android:textSize="14sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- Floating Add Task Button -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/addTaskFab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"
            android:contentDescription="Add Task"
            android:src="@android:drawable/ic_input_add"
            app:backgroundTint="@color/accent"
            app:layout_constraintBottom_toTopOf="@id/trophyRoomButton"
            app:layout_constraintEnd_toEndOf="parent"
            app:tint="@color/primaryText" />

        <!-- ==================== ZONE 3: THE TROPHY ROOM (Bottom) ==================== -->
        <LinearLayout
            android:id="@+id/trophyRoomButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_trophy_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingVertical="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_trophy"
                app:tint="@color/secondaryText" />

            <TextView
                android:id="@+id/trophyRoomText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.02"
                android:textColor="@color/secondaryText"
                android:textSize="14sp"
                tools:text="View 42 Completed Tasks >" />
        </LinearLayout>

        <!-- Back Button -->
        <ImageView
            android:id="@+id/backButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Back"
            android:focusable="true"
            android:padding="4dp"
            android:rotation="180"
            android:src="@drawable/ic_settings"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/secondaryText" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ==================== TROPHY ROOM BOTTOM SHEET ==================== -->
    <FrameLayout
        android:id="@+id/trophyRoomSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dialog_surface"
        android:elevation="16dp"
        android:visibility="gone"
        app:behavior_hideable="true"
        app:behavior_peekHeight="0dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Handle bar -->
            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_home_indicator" />

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:fontFamily="sans-serif-medium"
                android:text="Trophy Room"
                android:textColor="@color/primaryText"
                android:textSize="20sp" />

            <!-- Streak Visualizer -->
            <com.minimalist.launcher.ui.StreakVisualizerView
                android:id="@+id/streakVisualizer"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="16dp" />

            <!-- Completed Tasks List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/completedTasksRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:clipToPadding="false"
                android:paddingTop="8dp"
                android:scrollbars="vertical" />
        </LinearLayout>
    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
