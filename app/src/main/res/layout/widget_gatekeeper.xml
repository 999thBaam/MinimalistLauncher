<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#CC000000"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Goal + Countdown (tap to open Gatekeeper) -->
    <LinearLayout
        android:id="@+id/goalContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/widgetGoalText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:textAllCaps="true"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="IIT BOMBAY CSE" />

        <TextView
            android:id="@+id/widgetCountdownText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:textColor="#808080"
            android:textSize="12sp"
            tools:text="124 DAYS LEFT" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="12dp"
        android:background="#333333" />

    <!-- Tasks Container -->
    <LinearLayout
        android:id="@+id/tasksContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Task 1 -->
        <LinearLayout
            android:id="@+id/task1Container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="8dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/task1Checkbox"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_checkbox_unchecked" />

            <TextView
                android:id="@+id/task1Text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:textColor="#E0E0E0"
                android:textSize="15sp"
                tools:text="Complete Physics Chapter 4" />
        </LinearLayout>

        <!-- Task 2 -->
        <LinearLayout
            android:id="@+id/task2Container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="8dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/task2Checkbox"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_checkbox_unchecked" />

            <TextView
                android:id="@+id/task2Text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:textColor="#E0E0E0"
                android:textSize="15sp"
                tools:text="Math practice problems" />
        </LinearLayout>

        <!-- Task 3 -->
        <LinearLayout
            android:id="@+id/task3Container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="8dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/task3Checkbox"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_checkbox_unchecked" />

            <TextView
                android:id="@+id/task3Text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:textColor="#E0E0E0"
                android:textSize="15sp"
                tools:text="Chemistry revision" />
        </LinearLayout>

        <!-- Task 4 -->
        <LinearLayout
            android:id="@+id/task4Container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="8dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/task4Checkbox"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_checkbox_unchecked" />

            <TextView
                android:id="@+id/task4Text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:textColor="#E0E0E0"
                android:textSize="15sp"
                tools:text="Review notes" />
        </LinearLayout>

        <!-- Task 5 -->
        <LinearLayout
            android:id="@+id/task5Container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="8dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/task5Checkbox"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_checkbox_unchecked" />

            <TextView
                android:id="@+id/task5Text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:textColor="#E0E0E0"
                android:textSize="15sp"
                tools:text="Practice test" />
        </LinearLayout>

        <!-- Victory State -->
        <TextView
            android:id="@+id/victoryText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingVertical="16dp"
            android:text="Day Won. Rest Now. ✓"
            android:textColor="#708090"
            android:textSize="16sp"
            android:visibility="gone" />

        <!-- Empty State -->
        <TextView
            android:id="@+id/emptyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingVertical="16dp"
            android:text="Tap to add tasks"
            android:textColor="#808080"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Trophy Room Button (tap to open Gatekeeper) -->
    <TextView
        android:id="@+id/trophyButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_trophy_pill"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:textColor="#808080"
        android:textSize="12sp"
        tools:text="View 5 completed >" />

</LinearLayout>
