<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical">
    
    <!-- App Icon -->
    <ImageView
        android:id="@+id/shadow_item_icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="App icon" />
    
    <!-- Content -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">
        
        <!-- Sender -->
        <TextView
            android:id="@+id/shadow_item_sender"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="end" />
        
        <!-- Preview -->
        <TextView
            android:id="@+id/shadow_item_preview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#AAAAAA"
            android:textSize="14sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginTop="2dp" />
    </LinearLayout>
    
    <!-- Right side: time + count -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end"
        android:layout_marginStart="8dp">
        
        <!-- Time -->
        <TextView
            android:id="@+id/shadow_item_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#666666"
            android:textSize="12sp" />
        
        <!-- Unread count badge -->
        <TextView
            android:id="@+id/shadow_item_count"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:background="@drawable/bg_unread_badge"
            android:layout_marginTop="4dp"
            android:visibility="gone" />
    </LinearLayout>
    
</LinearLayout>
